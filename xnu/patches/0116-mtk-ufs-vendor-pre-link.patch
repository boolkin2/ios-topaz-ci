+
+/* MT6983 vendor PRE_CHANGE sequence, after DME_RESET and before training. */
+static int
+sweet_ufs_pre_link(void)
+{
+	uint32_t result, value, ignore;
+	int error;
+
+	error = sweet_ufs_uic_arg3(UIC_DME_SET, VS_UNIPROPOWERDOWNCONTROL << 16,
+	    0u, &result, &ignore);
+	UFS_MARK('U', '0', '4', '6', ((uint32_t)error << 8) | result);
+	if (error || result) {
+		return error ? error : EIO;
+	}
+
+	error = sweet_ufs_uic_arg3(UIC_DME_SET, PA_LOCAL_TX_LCC_ENABLE << 16,
+	    0u, &result, &ignore);
+	UFS_MARK('U', '0', '4', '7', ((uint32_t)error << 8) | result);
+	if (error || result) {
+		return error ? error : EIO;
+	}
+
+	error = sweet_ufs_uic(UIC_DME_GET, VS_SAVEPOWERCONTROL << 16, &result, &value);
+	UFS_MARK('U', '0', '4', '8', ((uint32_t)error << 8) | result);
+	if (error || result) {
+		return error ? error : EIO;
+	}
+
+	error = sweet_ufs_uic_arg3(UIC_DME_SET, VS_SAVEPOWERCONTROL << 16,
+	    value & ~VS_SAVEPOWER_DEEP_STALL, &result, &ignore);
+	UFS_MARK('U', '0', '4', '9', ((uint32_t)error << 8) | result);
+	return error ? error : (result ? EIO : 0);
 }
 
