+/* Sample every ROC latch once, before W1C, and classify a LINK_STARTUP UIC
+ * error as the isolated local PA LINERESET. That event may precede
+ * UIC_COMMAND_COMPL, but it is not proof that the link came up. Sampling and
+ * logging are separate so a storm of indications cannot flood pmsg. */
+struct sweet_ufs_link_snapshot {
+	uint32_t status;
+	uint32_t pa;
+	uint32_t dl;
+	uint32_t nl;
+	uint32_t tl;
+	uint32_t dme;
+};
+
 static bool
-sweet_ufs_link_reset_event(uint32_t status)
-{
-	uint32_t pa = sweet_ufs_rd(REG_UECPA);
-	uint32_t dl = sweet_ufs_rd(REG_UECDL);
-	uint32_t nl = sweet_ufs_rd(REG_UECN);
-	uint32_t tl = sweet_ufs_rd(REG_UECT);
-	uint32_t dme = sweet_ufs_rd(REG_UECDME);
-
-	UFS_MARK('L', 'I', 'S', 'R', status);
-	UFS_MARK('L', 'P', 'A', 'R', pa);
-	UFS_MARK('L', 'D', 'L', 'R', dl);
-	UFS_MARK('L', 'N', 'L', 'R', nl);
-	UFS_MARK('L', 'T', 'L', 'R', tl);
-	UFS_MARK('L', 'D', 'M', 'R', dme);
-	return pa == 0x80000010u &&
-	       !((dl | nl | tl | dme) & 0x80000000u);
+sweet_ufs_link_sample(uint32_t status, struct sweet_ufs_link_snapshot *sample)
+{
+	sample->status = status;
+	sample->pa = sweet_ufs_rd(REG_UECPA);
+	sample->dl = sweet_ufs_rd(REG_UECDL);
+	sample->nl = sweet_ufs_rd(REG_UECN);
+	sample->tl = sweet_ufs_rd(REG_UECT);
+	sample->dme = sweet_ufs_rd(REG_UECDME);
+	return sample->pa == 0x80000010u &&
+	    !((sample->dl | sample->nl | sample->tl | sample->dme) & 0x80000000u);
+}
+
+static bool
+sweet_ufs_link_same(const struct sweet_ufs_link_snapshot *a,
+    const struct sweet_ufs_link_snapshot *b)
+{
+	return a->status == b->status && a->pa == b->pa && a->dl == b->dl &&
+	    a->nl == b->nl && a->tl == b->tl && a->dme == b->dme;
+}
+
+/* LISR is the raw pre-W1C sample; completion/timeout log the post-W1C status. */
+static void
+sweet_ufs_link_log(const struct sweet_ufs_link_snapshot *sample)
+{
+	UFS_MARK('L', 'I', 'S', 'R', sample->status);
+	UFS_MARK('L', 'P', 'A', 'R', sample->pa);
+	UFS_MARK('L', 'D', 'L', 'R', sample->dl);
+	UFS_MARK('L', 'N', 'L', 'R', sample->nl);
+	UFS_MARK('L', 'T', 'L', 'R', sample->tl);
+	UFS_MARK('L', 'D', 'M', 'R', sample->dme);
+}
+
+/* Bounded diagnostics: one first snapshot, one last snapshot and totals. */
+static void
+sweet_ufs_link_count(uint32_t events, uint32_t repeats)
+{
+	UFS_MARK('L', 'T', 'O', 'T', events);
+	UFS_MARK('L', 'R', 'E', 'P', repeats);
 }
 
