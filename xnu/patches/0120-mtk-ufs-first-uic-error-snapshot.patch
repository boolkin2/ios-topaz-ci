--- a/bsd/dev/sweet_ufs.c
+++ b/bsd/dev/sweet_ufs.c
@@ -35,6 +35,9 @@
 #define REG_HCE             0x34
 #define REG_UECPA           0x38
 #define REG_UECDL           0x3c
+#define REG_UECN            0x40
+#define REG_UECT            0x44
+#define REG_UECDME          0x48
 #define REG_UTRLBA          0x50
 #define REG_UTRLBAU         0x54
 #define REG_UTRLDBR         0x58
@@ -530,6 +533,7 @@
 	struct sweet_ufs_ucd *ucd = (struct sweet_ufs_ucd *)(su.dma + DMA_UCD);
 	uint64_t ucd_pa = su.dma_pa + DMA_UCD;
 	uint64_t bounce_pa = su.dma_pa + DMA_BOUNCE;
+	static bool uic_snapshot_done;
 	uint32_t is = 0;
 	uint32_t hcs_before = 0, is_before = 0;
 	bool trace_tur = cdb_len == 6 && cdb[0] == 0x00;
@@ -612,6 +616,18 @@
 		sweet_ufs_delay_us(10);
 	}
 	uint32_t hcs_after = trace_tur ? sweet_ufs_rd(REG_HCS) : 0;
+	bool snapshot_uic = trace_tur && (is & IS_UIC_ERROR) && !uic_snapshot_done;
+	uint32_t uic_error[6] = { 0 };
+	if (snapshot_uic) {
+		uic_snapshot_done = true;
+		uic_error[0] = sweet_ufs_rd(REG_UTRLDBR);
+		/* Error-code reads may clear hardware latches: sample each once. */
+		uic_error[1] = sweet_ufs_rd(REG_UECPA);
+		uic_error[2] = sweet_ufs_rd(REG_UECDL);
+		uic_error[3] = sweet_ufs_rd(REG_UECN);
+		uic_error[4] = sweet_ufs_rd(REG_UECT);
+		uic_error[5] = sweet_ufs_rd(REG_UECDME);
+	}
 	sweet_ufs_wr(REG_IS, is);
 	if (trace_tur) {
 		sweet_ufs_tur_trace(hcs_before, is_before, is, hcs_after);
@@ -623,6 +639,23 @@
 	}
 
 	uint32_t ocs = utrd->dw2 & 0x0f;
+	if (snapshot_uic) {
+		/* Descriptor/UPIU values are read only after the existing DMA syncs. */
+		UFS_MARK('F', 'U', 'I', 'S', is);
+		UFS_MARK('F', 'U', 'H', 'C', hcs_after);
+		UFS_MARK('F', 'U', 'D', 'B', uic_error[0]);
+		UFS_MARK('F', 'U', 'P', 'A', uic_error[1]);
+		UFS_MARK('F', 'U', 'D', 'L', uic_error[2]);
+		UFS_MARK('F', 'U', 'N', 'L', uic_error[3]);
+		UFS_MARK('F', 'U', 'T', 'L', uic_error[4]);
+		UFS_MARK('F', 'U', 'D', 'M', uic_error[5]);
+		UFS_MARK('F', 'U', 'O', 'C', ocs);
+		/* Pack UPIU byte order explicitly; avoid unaligned word loads. */
+		UFS_MARK('F', 'U', 'R', '0', ((uint32_t)ucd->resp[0] << 24) |
+		    ((uint32_t)ucd->resp[1] << 16) | ((uint32_t)ucd->resp[2] << 8) | ucd->resp[3]);
+		UFS_MARK('F', 'U', 'R', '1', ((uint32_t)ucd->resp[4] << 24) |
+		    ((uint32_t)ucd->resp[5] << 16) | ((uint32_t)ucd->resp[6] << 8) | ucd->resp[7]);
+	}
 	if (!(is & IS_UTP_COMPLETE) || ocs || ucd->resp[0] != 0x21 || ucd->resp[6] || ucd->resp[7]) {
 		printf("SWEET UFS: command %02x failed: IS %08x OCS %x RSP %02x status %02x/%02x HCS %08x\n",
 		    cdb[0], is, ocs, ucd->resp[0], ucd->resp[6], ucd->resp[7], sweet_ufs_rd(REG_HCS));
