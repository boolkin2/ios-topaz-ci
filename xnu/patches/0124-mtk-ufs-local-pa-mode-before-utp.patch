+/* Local PA observations only; never infer or write a target power mode. */
+static int
+sweet_ufs_trace_pa_mode(void)
+{
+	static const uint32_t attrs[] = {
+		PA_PWRMODE, PA_TXPWRSTATUS, PA_RXPWRSTATUS, PA_TXGEAR,
+		PA_RXGEAR, PA_ACTIVETXDATALANES, PA_ACTIVERXDATALANES
+	};
+	uint32_t status = sweet_ufs_rd(REG_IS);
+	UFS_MARK('P', 'I', 'S', '0', status);
+	UFS_MARK('P', 'H', 'C', '0', sweet_ufs_rd(REG_HCS));
+	if (status & (IS_UIC_COMPLETE | IS_UIC_ERROR | IS_FATAL_MASK)) {
+		return EBUSY; /* Do not attribute a pending old event to a new GET. */
+	}
+	for (unsigned int i = 0; i < sizeof(attrs) / sizeof(attrs[0]); i++) {
+		uint32_t result = 0xffu, value = 0;
+		int error;
+		if (!(sweet_ufs_rd(REG_HCS) & HCS_UICRDY)) {
+			UFS_MARK('P', '0' + i, 'E', 'R', ENXIO);
+			return ENXIO;
+		}
+		error = sweet_ufs_uic(UIC_DME_GET, attrs[i] << 16, &result, &value);
+		UFS_MARK('P', '0' + i, 'E', 'R', error);
+		UFS_MARK('P', '0' + i, 'R', 'C', result);
+		UFS_MARK('P', '0' + i, 'V', 'L', value);
+		if (error || result) {
+			return error ? error : EIO;
+		}
+	}
+	UFS_MARK('P', 'D', 'O', 'N', 1u);
+	return 0;
+}
