+/* UFS QUERY REQUEST for the fDeviceInit device flag.  Vendor ufshcd sends
+ * SET FLAG and then polls READ FLAG until the device clears it; this host
+ * issues the same two standard requests, one attempt, no retry storm, and
+ * stops instead of touching media when the flag is not accepted. */
+static int
+sweet_ufs_query_flag(uint8_t opcode, bool *flag)
+{
+	struct sweet_ufs_utrd *utrd = (struct sweet_ufs_utrd *)(su.dma + DMA_UTRL);
+	struct sweet_ufs_ucd *ucd = (struct sweet_ufs_ucd *)(su.dma + DMA_UCD);
+	uint64_t ucd_pa = su.dma_pa + DMA_UCD;
+	uint32_t is = 0;
+	int list_error;
+
+	list_error = sweet_ufs_check_utrl(su.dma_pa + DMA_UTRL);
+	if (list_error) {
+		UFS_MARK('U', '0', '5', '4', list_error);
+		return list_error;
+	}
+	bzero(utrd, sizeof(*utrd));
+	bzero(ucd, sizeof(*ucd));
+	ucd->cmd[0] = UPIU_TRANSACTION_QUERY_REQ;
+	ucd->cmd[1] = 0;
+	ucd->cmd[2] = 0;	/* device management request: LUN 0 */
+	ucd->cmd[3] = ++su.tag;
+	ucd->cmd[5] = opcode == UPIU_QUERY_OPCODE_READ_FLAG ?
+	    UPIU_QUERY_FUNC_STANDARD_READ_REQUEST :
+	    UPIU_QUERY_FUNC_STANDARD_WRITE_REQUEST;
+	ucd->cmd[12] = opcode;
+	ucd->cmd[13] = QUERY_FLAG_IDN_FDEVICEINIT;
+	ucd->cmd[14] = 0;	/* index */
+	ucd->cmd[15] = 0;	/* selector */
+
+	utrd->dw0 = (1u << 24) | (1u << 28);
+	utrd->dw2 = 0x0f;
+	utrd->ucdba = (uint32_t)ucd_pa;
+	utrd->ucdbau = (uint32_t)(ucd_pa >> 32);
+	utrd->resp = (512u / 4u) << 16 | (512u / 4u);
+
+	sweet_ufs_dma_sync(DMA_UTRL, sizeof(*utrd));
+	sweet_ufs_dma_sync(DMA_UCD, sizeof(*ucd));
+	list_error = sweet_ufs_check_utrl(su.dma_pa + DMA_UTRL);
+	if (list_error) {
+		UFS_MARK('U', '0', '5', '4', list_error);
+		return list_error;
+	}
+	sweet_ufs_wr(REG_UTRLDBR, 1u);
+
+	uint64_t deadline;
+	nanoseconds_to_absolutetime(CMD_TIMEOUT_NS, &deadline);
+	deadline += mach_absolute_time();
+	while (!(is & (IS_UTP_COMPLETE | IS_UIC_ERROR | IS_FATAL_MASK))) {
+		is = sweet_ufs_rd(REG_IS);
+		if (is & (IS_UTP_COMPLETE | IS_UIC_ERROR | IS_FATAL_MASK)) {
+			break;
+		}
+		if (mach_absolute_time() > deadline) {
+			sweet_ufs_wr(REG_UTRLCLR, ~1u);
+			sweet_ufs_wr(REG_IS, sweet_ufs_rd(REG_IS));
+			return ETIMEDOUT;
+		}
+		sweet_ufs_delay_us(10);
+	}
+	sweet_ufs_wr(REG_IS, is);
+	sweet_ufs_dma_sync(DMA_UTRL, sizeof(*utrd));
+	sweet_ufs_dma_sync(DMA_UCD, sizeof(*ucd));
+
+	uint32_t ocs = utrd->dw2 & 0x0f;
+	if (!(is & IS_UTP_COMPLETE) || ocs || ucd->resp[0] != 0x36u ||
+	    ucd->resp[6] || ucd->resp[7]) {
+		UFS_MARK('F', 'D', 'E', 'R', is);
+		UFS_MARK('F', 'D', 'O', 'C', ocs);
+		UFS_MARK('F', 'D', 'R', 'S', ((uint32_t)ucd->resp[6] << 8) | ucd->resp[7]);
+		return EIO;
+	}
+	if (flag) {
+		/* Query response value is big-endian at bytes 20..23. */
+		*flag = (ucd->resp[23] & 1u) != 0;
+	}
+	return 0;
+}
