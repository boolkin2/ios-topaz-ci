+	 ((unsigned int)(c) << 16) | ((unsigned int)(d) << 24))
+#define UFS_MARK(a, b, c, d, value) sweet_late_mark(UFS_TAG(a, b, c, d), (unsigned int)(value))
+
+#define REG_IS              0x20
+#define REG_IE              0x24
+#define REG_HCS             0x30
+#define REG_HCE             0x34
+#define REG_UECPA           0x38
+#define REG_UECDL           0x3c
+#define REG_UTRLBA          0x50
+#define REG_UTRLBAU         0x54
+#define REG_UTRLDBR         0x58
+#define REG_UTRLCLR         0x5c
+#define REG_UTRLRSR         0x60
+#define REG_UTMRLBA         0x70
+#define REG_UTMRLBAU        0x74
+#define REG_UTMRLRSR        0x80
+#define REG_UICCMD          0x90
+#define REG_UICARG1         0x94
+#define REG_UICARG2         0x98
+#define REG_UICARG3         0x9c
+#define REG_XOUFS           0x140
+#define REG_REFCLK          0x144
+#define REG_MTK_HW_VER      0x2240
+
+#define HCS_DP              (1u << 0)
+#define HCS_UTRLRDY         (1u << 1)
+#define HCS_UICRDY          (1u << 3)
+#define IS_UTP_COMPLETE     (1u << 0)
+#define IS_UIC_COMPLETE     (1u << 10)
+#define IS_UIC_ERROR        (1u << 2)
+#define IS_FATAL_MASK       (1u << 11) | (1u << 16) | (1u << 17) | (1u << 18)
+
+#define UIC_DME_GET         0x01
+#define UIC_DME_PEER_GET    0x03
+#define UIC_DME_ENABLE      0x12
+#define UIC_DME_RESET       0x14
+#define UIC_DME_LINK_STARTUP 0x16
+#define UIC_DME_HIBER_EXIT  0x18
+#define UIC_RESULT_MASK     0xffu
+#define PA_PWRMODE          0x1571u
+
+#define PMIF_SWINF2_STA     0x8a8
+#define PMIF_SWINF2_WDATA   0x884
+#define PMIF_SWINF2_RDATA   0x894
+#define PMIF_SWINF2_ACC     0x880
+#define PMIF_SWINF2_VLD_CLR 0x8a4
+#define PMIF_STA_IDLE       0u
+#define PMIF_STA_WFVLDCLR   6u
+#define PMIF_STA_ERROR      (1u << 18)
+#define SPMI_EXT_REG_LONG   (3u << 30)
+#define SPMI_WRITE          (1u << 29)
+
+#define MT6685_XO_BBCK3_VOTE_L 0x550
+#define MT6685_XO_BBCK3_VOTE_H 0x551
+#define MT6685_XO_BBCK3_REG    0x79c
+#define MT6685_XO_BBCK3_EN_M   (1u << 2)
+#define MT6685_XO_BBCK3_MODE   0x3u
+#define SRCLKEN_M00_CFG       0x20
+#define SRCLKEN_SW_RC_EN       (1u << 3)
+#define SRCLKEN_SW_RC_REQ_MASK 0x3u
+#define SRCLKEN_SW_RC_REQ_SHIFT 4u
+
+#define MP_GLB_DIG_8C        0x008c
+#define MP_LN_DIG_RX_9C      0xa09c
+#define MP_LN_DIG_RX_AC      0xa0ac
+#define MP_LN_RX_44          0xb044
+#define MP_FRC_PLL_ISO_EN    (1u << 8)
+#define MP_PLL_ISO_EN        (1u << 9)
+#define MP_FRC_FRC_PWR_ON    (1u << 10)
+#define MP_PLL_PWR_ON        (1u << 11)
+#define MP_FSM_DIFZ_FRC      (1u << 18)
+#define MP_FRC_RX_SQ_EN      (1u << 0)
+#define MP_RX_SQ_EN          (1u << 1)
+#define MP_FRC_CDR_PWR_ON    (1u << 17)
+#define MP_CDR_PWR_ON        (1u << 18)
+#define MP_FRC_CDR_ISO_EN    (1u << 19)
+#define MP_CDR_ISO_EN        (1u << 20)
+
+#define BOUNCE_SIZE          (1u << 20)
+#define PRDT_CHUNK           (256u << 10)
+#define PRDT_MAX             (BOUNCE_SIZE / PRDT_CHUNK)
+#define CMD_TIMEOUT_NS       (5ull * NSEC_PER_SEC)
+#define UIC_TIMEOUT_NS       (1ull * NSEC_PER_SEC)
+#define SPMI_TIMEOUT_NS      (100ull * NSEC_PER_MSEC)
+
+#define DMA_UTRL             0x0000
+#define DMA_UCD              0x1000
+#define DMA_BOUNCE           0x4000
+#define DMA_SIZE             (DMA_BOUNCE + BOUNCE_SIZE)
