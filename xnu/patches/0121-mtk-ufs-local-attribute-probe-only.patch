+/* v235 diagnostic-only: do not issue a UPIU or take over either request list. */
+static int
+sweet_ufs_local_attr_probe(void)
+{
+	static const uint32_t attrs[] = {
+		VS_UNIPROPOWERDOWNCONTROL, PA_LOCAL_TX_LCC_ENABLE,
+		VS_SAVEPOWERCONTROL, PA_LOCALVERINFO
+	};
+	uint32_t status = sweet_ufs_rd(REG_IS);
+	uint32_t hcs = sweet_ufs_rd(REG_HCS);
+	int error = 0;
+	UFS_MARK('L', 'I', 'S', '0', status);
+	UFS_MARK('L', 'H', 'S', '0', hcs);
+	UFS_MARK('L', 'P', 'B', '0', sweet_ufs_read_link_probe());
+	/* These reads may clear latches. No earlier reads in the v235 path. */
+	UFS_MARK('L', 'P', 'A', '0', sweet_ufs_rd(REG_UECPA));
+	UFS_MARK('L', 'D', 'L', '0', sweet_ufs_rd(REG_UECDL));
+	if (status & (IS_UIC_COMPLETE | IS_UIC_ERROR | IS_FATAL_MASK)) {
+		error = EBUSY; /* Do not mistake a pending old event for our GET. */
+		goto out;
+	}
+	for (unsigned int i = 0; i < sizeof(attrs) / sizeof(attrs[0]); i++) {
+		uint32_t result = 0xffu, value = 0;
+		if (!(sweet_ufs_rd(REG_HCS) & HCS_UICRDY)) {
+			error = ENXIO;
+			UFS_MARK('L', '0' + i, 'E', 'R', error);
+			break;
+		}
+		error = sweet_ufs_uic(UIC_DME_GET, attrs[i] << 16, &result, &value);
+		UFS_MARK('L', '0' + i, 'E', 'R', error);
+		UFS_MARK('L', '0' + i, 'R', 'C', result);
+		UFS_MARK('L', '0' + i, 'V', 'L', value);
+		if (error || result) {
+			error = error ? error : EIO;
+			break; /* No retry or next command after an error. */
+		}
+	}
+out:
+	UFS_MARK('L', 'P', 'B', '1', sweet_ufs_read_link_probe());
+	UFS_MARK('L', 'H', 'S', '1', sweet_ufs_rd(REG_HCS));
+	UFS_MARK('L', 'I', 'S', '1', sweet_ufs_rd(REG_IS));
+	UFS_MARK('L', 'D', 'O', 'N', error == 0);
+	/* ECANCELED is intentional diagnostic completion, not a UFS read result. */
+	return error ? error : ECANCELED;
+}
