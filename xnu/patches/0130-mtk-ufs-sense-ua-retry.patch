+/* A device that just finished fDeviceInit reports UNIT ATTENTION on the first
+ * media command.  Decode the sense data and retry that command once; every
+ * other check condition is returned to the caller unchanged. */
+static int
+sweet_ufs_scsi(const uint8_t *cdb, unsigned int cdb_len, uint32_t len, bool write)
+{
+	int error = sweet_ufs_scsi_attempt(cdb, cdb_len, len, write);
+
+	if (error && cdb_len && su_rsp_status == 0x01u &&
+	    su_sense_key == UFS_SENSE_KEY_UNIT_ATTENTION) {
+		UFS_MARK('U', '0', '7', '3', ((uint32_t)su_sense_asc << 8) | su_sense_ascq);
+		sweet_ufs_delay_us(UFS_UA_RETRY_DELAY_US);
+		error = sweet_ufs_scsi_attempt(cdb, cdb_len, len, write);
+		UFS_MARK('U', '0', '7', '4', error ? 0xffffffffu : 0u);
+	}
+	return error;
+}
