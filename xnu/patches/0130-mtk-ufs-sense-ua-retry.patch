+/* Sense data from the last SCSI command, decoded from the response UPIU.
+ * Kept outside the request path so the retry wrapper can inspect it. */
+static uint8_t su_rsp_status;
+static uint8_t su_sense_key;
+static uint8_t su_sense_asc;
+static uint8_t su_sense_ascq;
+static uint32_t su_sense_len;
+
+static void
+sweet_ufs_sense_snapshot(void)
+{
+	struct sweet_ufs_ucd *ucd = (struct sweet_ufs_ucd *)(su.dma + DMA_UCD);
+
+	su_rsp_status = ucd->resp[6];
+	su_sense_len = ((uint32_t)ucd->resp[UPIU_RSP_SENSE_LENGTH_OFFSET] << 8) |
+	    ucd->resp[UPIU_RSP_SENSE_LENGTH_OFFSET + 1u];
+	su_sense_key = 0;
+	su_sense_asc = 0;
+	su_sense_ascq = 0;
+	if (su_sense_len >= 14u) {
+		su_sense_key = ucd->resp[UPIU_RSP_SENSE_DATA_OFFSET + 2u] & 0x0fu;
+		su_sense_asc = ucd->resp[UPIU_RSP_SENSE_DATA_OFFSET + 12u];
+		su_sense_ascq = ucd->resp[UPIU_RSP_SENSE_DATA_OFFSET + 13u];
+	}
+	UFS_MARK('U', '0', '7', '0', su_rsp_status);
+	UFS_MARK('U', '0', '7', '1', (su_sense_len << 8) | su_sense_key);
+	UFS_MARK('U', '0', '7', '2', ((uint32_t)su_sense_asc << 8) | su_sense_ascq);
+}
