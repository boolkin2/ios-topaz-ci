+/* Android keeps the boot LUNs (0 and 1) small and the GPT on the next LUN.
+ * Probe the fixed UFS LUN range, accept the first LUN whose LBA 1 carries a
+ * GPT signature, and keep that capacity for the partition lookup. */
+static int
+sweet_ufs_select_lun(void)
+{
+	uint8_t *b = (uint8_t *)(su.dma + DMA_BOUNCE);
+
+	for (uint32_t lun = 0; lun < UFS_MAX_LUNS; lun++) {
+		int error;
+
+		su.lun = (uint8_t)lun;
+		su_scanning = true;
+		error = sweet_ufs_read_capacity();
+		if (!error && su.device_blocks > UFS_GPT_LBA) {
+			error = sweet_ufs_transfer_blocks(UFS_GPT_LBA, 1, false);
+		}
+		su_scanning = false;
+		if (error) {
+			continue;
+		}
+		if (memcmp(b, "EFI PART", 8) != 0) {
+			continue;
+		}
+		UFS_MARK('U', '0', '8', '0', lun);
+		printf("SWEET UFS: GPT on LUN %u, %llu blocks x %u bytes\n",
+		    lun, su.device_blocks, su.block_size);
+		return 0;
+	}
+	printf("SWEET UFS: no GPT on LUNs 0..%u\n", UFS_MAX_LUNS - 1u);
+	return ENXIO;
+}
