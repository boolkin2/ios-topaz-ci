+/* Read vendor link state, restoring the debug mux rather than changing PHY. */
+static uint32_t
+sweet_ufs_read_link_probe(void)
+{
+	const bool wide = ((sweet_ufs_rd(REG_MTK_HW_VER) >> 16) & 0xffu) >= 0x36u;
+	const uint32_t sel = sweet_ufs_rd(REG_MTK_DEBUG_SEL);
+	uint32_t b0 = 0, b1 = 0, b2 = 0, b3 = 0, probe;
+
+	if (wide) {
+		b0 = sweet_ufs_rd(REG_MTK_DEBUG_B0);
+		b1 = sweet_ufs_rd(REG_MTK_DEBUG_B0 + 4u);
+		b2 = sweet_ufs_rd(REG_MTK_DEBUG_B0 + 8u);
+		b3 = sweet_ufs_rd(REG_MTK_DEBUG_B0 + 12u);
+		sweet_ufs_wr(REG_MTK_DEBUG_SEL, 0x820820u);
+		for (unsigned int i = 0; i < 4; i++) {
+			sweet_ufs_wr(REG_MTK_DEBUG_B0 + 4u * i, 0x55555555u * i);
+		}
+	} else {
+		sweet_ufs_wr(REG_MTK_DEBUG_SEL, 0x20u);
+	}
+	probe = sweet_ufs_rd(REG_MTK_PROBE);
+	if (wide) {
+		sweet_ufs_wr(REG_MTK_DEBUG_B0, b0);
+		sweet_ufs_wr(REG_MTK_DEBUG_B0 + 4u, b1);
+		sweet_ufs_wr(REG_MTK_DEBUG_B0 + 8u, b2);
+		sweet_ufs_wr(REG_MTK_DEBUG_B0 + 12u, b3);
+	}
+	sweet_ufs_wr(REG_MTK_DEBUG_SEL, sel);
+	return probe;
+}
+
+static void
+sweet_ufs_trace_link(char stage)
+{
+	UFS_MARK('L', 'S', 'P', stage, sweet_ufs_read_link_probe());
+	UFS_MARK('A', 'H', 'I', stage, sweet_ufs_rd(REG_AHIT));
+	UFS_MARK('E', 'P', 'A', stage, sweet_ufs_rd(REG_UECPA));
+	UFS_MARK('E', 'D', 'L', stage, sweet_ufs_rd(REG_UECDL));
+	UFS_MARK('X', 'O', 'U', stage, sweet_ufs_rd(REG_XOUFS));
+	UFS_MARK('M', 'P', 'G', stage, sweet_ufs_rd32(su.mphy, MP_GLB_DIG_8C));
+	UFS_MARK('M', 'P', 'L', stage, sweet_ufs_rd32(su.lk_phy, 0x208c));
+}
