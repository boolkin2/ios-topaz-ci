+/* Both the list installation and each doorbell must prove the host is ours. */
+static int
+sweet_ufs_check_utrl(uint64_t list)
+{
+	uint32_t hcs = sweet_ufs_rd(REG_HCS);
+	if (!(sweet_ufs_rd(REG_HCE) & 1u) ||
+	    (hcs & (HCS_DP | HCS_UTRLRDY)) != (HCS_DP | HCS_UTRLRDY)) {
+		return ENXIO;
+	}
+	if (sweet_ufs_rd(REG_UTRLDBR) != 0u) {
+		return EBUSY;
+	}
+	if (sweet_ufs_rd(REG_UTRLBA) != (uint32_t)list ||
+	    sweet_ufs_rd(REG_UTRLBAU) != (uint32_t)(list >> 32) ||
+	    !(sweet_ufs_rd(REG_UTRLRSR) & 1u)) {
+		return EIO;
+	}
+	return 0;
+}
